<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- KPI Result Tree View -->
        <record id="kpi_result_view_tree" model="ir.ui.view">
            <field name="name">kpi.result.tree</field>
            <field name="model">kpi.result</field>
            <field name="arch" type="xml">
                <list string="KPI Results"
                      multi_edit="1"
                      sample="1"
                      decoration-success="rag_status == 'green'"
                      decoration-warning="rag_status == 'amber'"
                      decoration-danger="rag_status == 'red'">
                    <field name="employee_id"/>
                    <field name="template_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="period_name" string="Period"/>
                    <field name="target_value" optional="hide"/>
                    <field name="actual_value"/>
                    <field name="score" widget="progressbar"/>
                    <field name="rag_status" widget="badge"
                           decoration-success="rag_status == 'green'"
                           decoration-warning="rag_status == 'amber'"
                           decoration-danger="rag_status == 'red'"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'approved'"
                           decoration-info="state == 'submitted'"
                           decoration-warning="state == 'returned'"/>
                    <field name="company_id" groups="base.group_multi_company" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- KPI Result Form View -->
        <record id="kpi_result_view_form" model="ir.ui.view">
            <field name="name">kpi.result.form</field>
            <field name="model">kpi.result</field>
            <field name="arch" type="xml">
                <form string="KPI Result">
                    <header>
                        <!-- Draft state buttons -->
                        <button name="action_submit"
                                string="Submit for Review"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ('draft', 'returned')"/>
                        <!-- Review/Approve buttons -->
                        <button name="action_review"
                                string="Review"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'submitted'"
                                groups="hr_performance_kpi.group_kpi_manager"/>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ('submitted', 'reviewed')"
                                groups="hr_performance_kpi.group_kpi_manager"/>
                        <!-- Return/Reset buttons -->
                        <button name="action_return"
                                string="Return"
                                type="object"
                                class="btn-secondary"
                                invisible="state not in ('submitted', 'reviewed')"
                                groups="hr_performance_kpi.group_kpi_manager"/>
                        <button name="action_reset_draft"
                                string="Reset to Draft"
                                type="object"
                                class="btn-secondary"
                                invisible="state != 'returned'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,reviewed,approved"/>
                    </header>
                    <sheet>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <label for="template_id" class="oe_edit_only"/>
                                <h3 class="mb-0">
                                    <field name="template_id"
                                           options="{'no_create': True}"
                                           readonly="1"/>
                                </h3>
                            </div>
                            <field name="rag_status" widget="badge" nolabel="1"
                                   decoration-success="rag_status == 'green'"
                                   decoration-warning="rag_status == 'amber'"
                                   decoration-danger="rag_status == 'red'"/>
                        </div>

                        <group col="12">
                            <group colspan="6" string="Period Information">
                                <field name="employee_id"
                                       widget="many2one_avatar_employee"
                                       readonly="1"/>
                                <field name="assignment_id"
                                       readonly="1"
                                       invisible="not assignment_id"/>
                                <field name="period_start"/>
                                <field name="period_end"/>
                                <field name="period_name" readonly="1"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"
                                       invisible="1"/>
                            </group>
                            <group colspan="6" string="Performance Values">
                                <field name="target_value" readonly="1"/>
                                <field name="actual_value"
                                       readonly="state not in ('draft', 'returned')"/>
                                <label for="score" string="Computed Score"/>
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <field name="score" widget="progressbar"
                                           class="flex-grow-1"
                                       nolabel="1"/>
                                    <field name="rag_status"
                                           widget="badge"
                                           nolabel="1"
                                           decoration-success="rag_status == 'green'"
                                           decoration-warning="rag_status == 'amber'"
                                           decoration-danger="rag_status == 'red'"
                                           invisible="1"/>
                                </div>
                            </group>
                        </group>

                        <notebook>
                            <page string="Review &amp; Notes" name="review_page">
                                <group col="12">
                                    <group colspan="6" string="Review Details"
                                           invisible="state == 'draft'">
                                        <field name="reviewer_id" readonly="1"/>
                                        <field name="reviewed_date" readonly="1"/>
                                    </group>
                                    <group colspan="6" string="Notes">
                                        <field name="notes"
                                               nolabel="1"
                                               colspan="2"
                                               placeholder="Add notes for the reviewer…"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- KPI Result Search View -->
        <record id="kpi_result_view_search" model="ir.ui.view">
            <field name="name">kpi.result.search</field>
            <field name="model">kpi.result</field>
            <field name="arch" type="xml">
                <search string="KPI Results">
                    <field name="template_id"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Submitted" name="filter_submitted"
                            domain="[('state', '=', 'submitted')]"/>
                    <filter string="Approved" name="filter_approved"
                            domain="[('state', '=', 'approved')]"/>
                    <separator/>
                    <filter string="Green" name="filter_green"
                            domain="[('rag_status', '=', 'green')]"/>
                    <filter string="Amber" name="filter_amber"
                            domain="[('rag_status', '=', 'amber')]"/>
                    <filter string="Red" name="filter_red"
                            domain="[('rag_status', '=', 'red')]"/>
                    <separator/>
                    <filter string="My Results" name="filter_my"
                            domain="[('employee_id.user_id', '=', uid)]"/>
                    <filter string="My Team" name="filter_my_team"
                            domain="[('employee_id.parent_id.user_id', '=', uid)]"
                            groups="hr_performance_kpi.group_kpi_manager"/>
                    <group>
                        <filter name="group_employee" string="Employee"
                                domain="[]" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_template" string="Template"
                                domain="[]" context="{'group_by': 'template_id'}"/>
                        <filter name="group_rag" string="RAG Status"
                                domain="[]" context="{'group_by': 'rag_status'}"/>
                        <filter name="group_state" string="Status"
                                domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- KPI Result Pivot View -->
        <record id="kpi_result_view_pivot" model="ir.ui.view">
            <field name="name">kpi.result.pivot</field>
            <field name="model">kpi.result</field>
            <field name="arch" type="xml">
                <pivot string="KPI Results Analysis" disable_linking="True">
                    <field name="employee_id" type="row"/>
                    <field name="template_id" type="col"/>
                    <field name="score" type="measure"/>
                    <field name="rag_status" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- KPI Result Graph View -->
        <record id="kpi_result_view_graph" model="ir.ui.view">
            <field name="name">kpi.result.graph</field>
            <field name="model">kpi.result</field>
            <field name="arch" type="xml">
                <graph string="KPI Results Trends">
                    <field name="employee_id" type="row"/>
                    <field name="period_start" type="col"/>
                    <field name="score" type="measure"/>
                </graph>
            </field>
        </record>
    </data>
</odoo>
