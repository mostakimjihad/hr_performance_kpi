<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- KPI Category Tree View -->
        <record id="kpi_category_view_tree" model="ir.ui.view">
            <field name="name">kpi.category.tree</field>
            <field name="model">kpi.category</field>
            <field name="arch" type="xml">
                <list string="KPI Categories"
                      multi_edit="1"
                      sample="1"
                      decoration-muted="not active">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="template_count" string="Templates" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- KPI Category Form View -->
        <record id="kpi_category_view_form" model="ir.ui.view">
            <field name="name">kpi.category.form</field>
            <field name="model">kpi.category</field>
            <field name="arch" type="xml">
                <form string="KPI Category">
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button class="oe_stat_button"
                                    name="action_view_templates"
                                    type="object"
                                    icon="fa-bar-chart">
                                <div class="o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="template_count"/>
                                    </span>
                                    <span class="o_stat_text">Templates</span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Category Name"/>
                            </h1>
                        </div>
                        <group col="12">
                            <group colspan="6">
                                <field name="parent_id"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                <field name="color" widget="color_picker" string="Color"/>
                            </group>
                            <group colspan="6">
                                <field name="description" colspan="2"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="KPI Templates" name="templates_page">
                                <field name="template_ids"
                                       nolabel="1"
                                       colspan="2"
                                       context="{'default_category_id': id}">
                                    <list string="Templates" editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="kpi_type"/>
                                        <field name="direction"/>
                                        <field name="periodicity"/>
                                        <field name="weight"/>
                                        <field name="calculation_method"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- KPI Category Search View -->
        <record id="kpi_category_view_search" model="ir.ui.view">
            <field name="name">kpi.category.search</field>
            <field name="model">kpi.category</field>
            <field name="arch" type="xml">
                <search string="KPI Categories">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="group_parent" string="Parent Category"
                                domain="[]" context="{'group_by': 'parent_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- KPI Category Kanban View -->
        <record id="kpi_category_view_kanban" model="ir.ui.view">
            <field name="name">kpi.category.kanban</field>
            <field name="model">kpi.category</field>
            <field name="arch" type="xml">
                <kanban class="o_kpi_category_kanban" sample="1">
                    <field name="color"/>
                    <field name="color_class"/>
                    <field name="template_count"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_card_content">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span t-attf-class="fa fa-circle text-#{record.color_class.raw_value}"/>
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="text-muted small">
                                    <field name="template_count"/>
                                    <span> Template(s)</span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>
