<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_branch_tree" model="ir.ui.view">
        <field name="name">salon.branch.tree</field>
        <field name="model">salon.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="manager_id"/>
                <field name="appointment_count"/>
                <field name="online_visible" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_salon_branch_form" model="ir.ui.view">
        <field name="name">salon.branch.form</field>
        <field name="model">salon.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_salon_appointment_list_by_branch)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo"
                                   string="Appointments"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Branch name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Opening Hours" name="hours">
                            <field name="hour_ids">
                                <list editable="bottom">
                                    <field name="dayofweek"/>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                    <field name="break_from" widget="float_time"/>
                                    <field name="break_to" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stylists" name="stylists">
                            <field name="stylist_ids"/>
                        </page>
                        <page string="Chairs" name="chairs">
                            <field name="chair_ids"/>
                        </page>
                        <page string="Visibility" name="visibility">
                            <group>
                                <field name="online_visible"/>
                                <field name="active"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_salon_branch_kanban" model="ir.ui.view">
        <field name="name">salon.branch.kanban</field>
        <field name="model">salon.branch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="appointment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record oe_kanban_global_click">
                            <field name="image" widget="image" class="o_kanban_image_fill w-100"
                                   alt="Branch image"/>
                            <div class="o_kanban_details">
                                <strong><t t-esc="record.name.value"/></strong>
                                <div t-esc="record.code.value"/>
                                <div class="text-muted">
                                    <i class="fa fa-calendar"/> <t t-esc="record.appointment_count.value"/> appointments
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_branch_search" model="ir.ui.view">
        <field name="name">salon.branch.search</field>
        <field name="model">salon.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <separator/>
                <filter string="Online visible" name="online_visible"
                        domain="[('online_visible', '=', True)]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_salon_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">salon.branch</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_salon_branch_search"/>
        <field name="context">{}</field>
    </record>

</odoo>