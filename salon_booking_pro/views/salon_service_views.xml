<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_service_tree" model="ir.ui.view">
        <field name="name">salon.service.tree</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="duration_minutes" string="Duration (min)"/>
                <field name="list_price" widget="monetary"/>
                <field name="online_visible" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_salon_service_form" model="ir.ui.view">
        <field name="name">salon.service.form</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="duration" widget="float_time"/>
                            <field name="list_price" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="online_visible"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Branches" name="branches">
                            <field name="branch_ids" widget="many2many_tags"/>
                            <p class="text-muted">
                                Leave empty to make this service available at every branch.
                            </p>
                        </page>
                        <page string="Stylists" name="stylists">
                            <field name="stylist_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_salon_service_kanban" model="ir.ui.view">
        <field name="name">salon.service.kanban</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="list_price"/>
                <field name="duration_minutes"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record oe_kanban_global_click">
                            <field name="image" widget="image" class="o_kanban_image_fill w-100"
                                   alt="Service image"/>
                            <div class="o_kanban_details">
                                <strong><t t-esc="record.name.value"/></strong>
                                <div class="text-muted">
                                    <t t-esc="record.category_id.value"/>
                                </div>
                                <div>
                                    <t t-esc="record.list_price.value"/>
                                    ·
                                    <t t-esc="record.duration_minutes.value"/> min
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_service_search" model="ir.ui.view">
        <field name="name">salon.service.search</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <search string="Services">
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Online visible" name="online_visible"
                        domain="[('online_visible', '=', True)]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" domain="[]"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_salon_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">salon.service</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_salon_service_search"/>
    </record>

</odoo>