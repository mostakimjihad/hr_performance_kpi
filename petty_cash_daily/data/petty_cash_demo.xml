<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Two demo funds: Front Desk (active) and Cafeteria (active) -->
        <record id="fund_front_desk" model="petty.cash.fund">
            <field name="name">Front Desk Drawer</field>
            <field name="code">FRONT</field>
            <field name="custodian_id" ref="hr.employee_admin"/>
            <field name="branch_name">Reception — Floor 1</field>
            <field name="opening_balance" eval="200.0"/>
            <field name="alert_threshold" eval="50.0"/>
            <field name="transaction_limit" eval="25.0"/>
            <field name="monthly_budget" eval="1500.0"/>
            <field name="color">0</field>
            <field name="state">active</field>
        </record>

        <record id="fund_cafeteria" model="petty.cash.fund">
            <field name="name">Cafeteria Float</field>
            <field name="code">CAFE</field>
            <field name="custodian_id" ref="hr.employee_admin"/>
            <field name="branch_name">Staff Cafeteria</field>
            <field name="opening_balance" eval="350.0"/>
            <field name="alert_threshold" eval="80.0"/>
            <field name="transaction_limit" eval="50.0"/>
            <field name="monthly_budget" eval="2500.0"/>
            <field name="color">1</field>
            <field name="state">active</field>
        </record>

        <!-- Today's session for Front Desk (DateTime.today() lives in the
             XML eval context; ``fields`` does not — that's an Odoo API
             symbol, not a runtime import. ``DateTime`` is the odoo.fields
             export shim loaded into the eval namespace.) -->
        <record id="session_front_today" model="petty.cash.session">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="opening_balance" eval="200.0"/>
            <field name="state">open</field>
        </record>

        <!-- A handful of past-week transactions for variety in demo data -->
        <record id="tx_demo_travel_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=6)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="18.50"/>
            <field name="category_id" ref="cat_travel"/>
            <field name="description">Taxi to client meeting</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=6)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_meals_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="32.40"/>
            <field name="category_id" ref="cat_meals"/>
            <field name="description">Lunch with visiting supplier</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_supplies_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="12.99"/>
            <field name="category_id" ref="cat_office_supplies"/>
            <field name="description">Replacement keyboard</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=4)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_replenish_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="direction">in</field>
            <field name="amount" eval="100.0"/>
            <field name="category_id" ref="cat_replenishment"/>
            <field name="description">Top-up from main safe</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=4)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_postage_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="15.0"/>
            <field name="category_id" ref="cat_postage"/>
            <field name="description">Courier to vendor</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_travel_2" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="22.0"/>
            <field name="category_id" ref="cat_travel"/>
            <field name="description">Bus pass top-up</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=2)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_fuel_1" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_cafeteria"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="58.0"/>
            <field name="category_id" ref="cat_fuel"/>
            <field name="description">Generator fuel top-up</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_meals_2" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_cafeteria"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="42.0"/>
            <field name="category_id" ref="cat_meals"/>
            <field name="description">Team lunch Friday</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>
        <record id="tx_demo_pending" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="85.0"/>
            <field name="category_id" ref="cat_utilities"/>
            <field name="description">Emergency plumbing repair</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">submitted</field>
        </record>
        <record id="tx_demo_today_small" model="petty.cash.transaction">
            <field name="fund_id" ref="fund_front_desk"/>
            <field name="date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="direction">out</field>
            <field name="amount" eval="6.50"/>
            <field name="category_id" ref="cat_postage"/>
            <field name="description">Stamps for invoices</field>
            <field name="submitter_id" ref="hr.employee_admin"/>
            <field name="state">paid</field>
            <field name="paid_date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        </record>
    </data>
</odoo>
