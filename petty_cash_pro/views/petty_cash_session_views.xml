<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree -->
        <record id="petty_cash_session_view_tree" model="ir.ui.view">
            <field name="name">petty.cash.session.tree</field>
            <field name="model">petty.cash.session</field>
            <field name="arch" type="xml">
                <list string="Daily Sessions"
                      decoration-warning="state == 'closing'"
                      decoration-success="state == 'closed'"
                      decoration-danger="variance &lt; 0 and state in ('closed','closing')">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="fund_id"/>
                    <field name="custodian_id" widget="many2one_avatar_employee"/>
                    <field name="opening_balance" widget="monetary"/>
                    <field name="paid_in" widget="monetary"/>
                    <field name="paid_out" widget="monetary"/>
                    <field name="expected_balance" widget="monetary"/>
                    <field name="actual_balance" widget="monetary"/>
                    <field name="variance" widget="monetary"/>
                    <field name="transaction_count"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'closed'"
                           decoration-warning="state == 'closing'"
                           decoration-info="state == 'open'"
                           decoration-danger="state == 'disputed'"/>
                </list>
            </field>
        </record>

        <!-- Form -->
        <record id="petty_cash_session_view_form" model="ir.ui.view">
            <field name="name">petty.cash.session.form</field>
            <field name="model">petty.cash.session</field>
            <field name="arch" type="xml">
                <form string="Daily Session">
                    <header>
                        <button name="action_start_closing" type="object" string="Start Closing"
                                invisible="state != 'open'"/>
                        <button name="action_close" type="object" string="Close Session"
                                invisible="state not in ('open','closing')"
                                class="btn-primary"
                                confirm="Confirm the actual cash count and close the session?"/>
                        <button name="action_dispute" type="object" string="Dispute Variance"
                                invisible="state in ('closed','confirmed','disputed')"
                                confirm="Mark this session as disputed for review?"/>
                        <button name="action_confirm" type="object" string="Confirm"
                                invisible="state != 'closed'"
                                class="btn-primary"/>
                        <button name="action_reopen" type="object" string="Reopen"
                                invisible="state not in ('closing','closed','disputed') or confirmed_by != False"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="open,closing,closed,confirmed"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="date"/>
                                <field name="fund_id"/>
                                <field name="custodian_id" widget="many2one_avatar_employee"
                                       invisible="1"/>
                            </group>
                            <group>
                                <field name="opened_at"/>
                                <field name="opened_by" widget="many2one_avatar_user"/>
                                <field name="closed_at" invisible="not closed_at"/>
                                <field name="closed_by" widget="many2one_avatar_user"
                                       invisible="not closed_by"/>
                                <field name="confirmed_by" widget="many2one_avatar_user"
                                       invisible="not confirmed_by"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="opening_balance" widget="monetary"/>
                                <field name="paid_in" widget="monetary"/>
                                <field name="paid_out" widget="monetary"/>
                                <field name="expected_balance" widget="monetary"
                                       class="fw-bold text-info"/>
                                <field name="actual_balance" widget="monetary"
                                       class="fs-4 fw-bold"/>
                                <field name="variance" widget="monetary"
                                       decoration-danger="variance &lt; 0"
                                       decoration-success="variance &gt; 0"
                                       decoration-muted="variance == 0"/>
                            </group>

                            <group>
                                <field name="notes" nolabel="1"
                                       placeholder="Variance explanation, handover notes..."/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Transactions" name="transactions">
                                <field name="transaction_ids"
                                       readonly="1"
                                       nolabel="1"
                                       mode="list"
                                       default_order="date desc, id desc">
                                    <list decoration-warning="state == 'submitted'"
                                          decoration-success="state == 'paid'"
                                          decoration-danger="state == 'rejected'"
                                          decoration-muted="state == 'cancelled'"
                                          string="Transactions"
                                          limit="20">
                                        <field name="date" optional="show"/>
                                        <field name="name" string="Reference" optional="show"/>
                                        <field name="direction" widget="badge"
                                               decoration-success="direction == 'in'"
                                               decoration-danger="direction == 'out'"
                                               optional="show"/>
                                        <field name="amount" widget="monetary" optional="show"/>
                                        <field name="category_id" optional="show"/>
                                        <field name="description" optional="hide"/>
                                        <field name="state" widget="badge" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search -->
        <record id="petty_cash_session_view_search" model="ir.ui.view">
            <field name="name">petty.cash.session.search</field>
            <field name="model">petty.cash.session</field>
            <field name="arch" type="xml">
                <search string="Sessions">
                    <field name="name"/>
                    <field name="fund_id"/>
                    <field name="custodian_id"/>
                    <separator/>
                    <filter name="filter_today" string="Today"
                            domain="[('date', '=', context_today())]"/>
                    <filter name="filter_open" string="Open" domain="[('state', '=', 'open')]"/>
                    <filter name="filter_closing" string="Closing"
                            domain="[('state', '=', 'closing')]"/>
                    <filter name="filter_closed" string="Closed"
                            domain="[('state', '=', 'closed')]"/>
                    <group>
                        <filter name="group_fund" string="Cash Box" context="{'group_by': 'fund_id'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Calendar -->
        <record id="petty_cash_session_view_calendar" model="ir.ui.view">
            <field name="name">petty.cash.session.calendar</field>
            <field name="model">petty.cash.session</field>
            <field name="arch" type="xml">
                <calendar string="Sessions" date_start="opened_at"
                          date_stop="closed_at"
                          color="fund_id"
                          quick_create="false">
                    <field name="name"/>
                    <field name="fund_id"/>
                    <field name="variance"/>
                </calendar>
            </field>
        </record>
    </data>
</odoo>
