<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily cron: close yesterday's open session(s), open today's -->
        <record id="ir_cron_petty_cash_open_daily" model="ir.cron">
            <field name="name">Petty Cash: Open / Close Daily Sessions</field>
            <field name="model_id" ref="model_petty_cash_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_yesterday()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
            <field name="nextcall">2026-08-17 00:30:00</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
