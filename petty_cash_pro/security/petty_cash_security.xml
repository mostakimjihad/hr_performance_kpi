<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===========================================================
         Module Category — sits under Accounting so it shows up next
         to Expenses / Invoicing in Settings.
         =========================================================== -->
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="sequence">192</field>
        <field name="parent_id" ref="base.module_category_accounting"/>
    </record>

    <!-- ===========================================================
         Privilege — Odoo 19 ties groups to a privilege.
         =========================================================== -->
    <record id="privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Petty Cash</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="sequence">10</field>
    </record>

    <!-- ===========================================================
         Groups
         =========================================================== -->
    <record id="group_petty_cash_auditor" model="res.groups">
        <field name="name">Petty Cash Auditor</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to all funds, transactions, sessions and replenishments.</field>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">Petty Cash User</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">View funds, open sessions, submit expenses and replenishments.</field>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Petty Cash Manager</field>
        <field name="privilege_id" ref="privilege_petty_cash"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access — approve transactions, close sessions, configure funds and categories.</field>
    </record>

    <!-- ===========================================================
         Record Rules
         =========================================================== -->
    <data noupdate="1">
        <!-- Multi-company rules -->
        <record id="pc_fund_comp_rule" model="ir.rule">
            <field name="name">Petty Cash Fund: multi-company</field>
            <field name="model_id" ref="model_petty_cash_fund"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="pc_category_comp_rule" model="ir.rule">
            <field name="name">Petty Cash Category: multi-company</field>
            <field name="model_id" ref="model_petty_cash_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="pc_transaction_comp_rule" model="ir.rule">
            <field name="name">Petty Cash Transaction: multi-company</field>
            <field name="model_id" ref="model_petty_cash_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="pc_session_comp_rule" model="ir.rule">
            <field name="name">Petty Cash Session: multi-company</field>
            <field name="model_id" ref="model_petty_cash_session"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="pc_replenishment_comp_rule" model="ir.rule">
            <field name="name">Petty Cash Replenishment: multi-company</field>
            <field name="model_id" ref="model_petty_cash_replenishment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Transaction rule: users see their own or custodian-fund transactions -->
        <record id="pc_transaction_user_rule" model="ir.rule">
            <field name="name">Petty Cash Transaction: own or custodian scope</field>
            <field name="model_id" ref="model_petty_cash_transaction"/>
            <field name="domain_force">[
                '|', '|',
                ('submitter_user_id', '=', user.id),
                ('fund_id.custodian_user_id', '=', user.id),
                ('fund_id.department_id.manager_id.user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
        </record>

        <!-- Replenishment rule: users see their own requests -->
        <record id="pc_replenishment_user_rule" model="ir.rule">
            <field name="name">Petty Cash Replenishment: own requests</field>
            <field name="model_id" ref="model_petty_cash_replenishment"/>
            <field name="domain_force">[
                '|', '|',
                ('requested_by', '=', user.id),
                ('fund_id.custodian_user_id', '=', user.id),
                ('fund_id.department_id.manager_id.user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
        </record>
    </data>
</odoo>
