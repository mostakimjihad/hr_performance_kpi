<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="salon_management.ChairDashboard" owl="1">
        <div class="o_action_manager">
            <div class="salon-chair-dashboard">
                <!-- Header -->
                <div class="salon-cdb-header">
                    <div class="salon-cdb-header-left">
                        <h1>
                            <i class="fa fa-th-large me-2"/>
                            Chair Dashboard
                        </h1>
                        <p class="text-muted mb-0">
                            Live status of every chair at your branch. Tap a chair to see its bookings.
                        </p>
                    </div>
                    <div class="salon-cdb-header-right">
                        <select class="form-select form-select-sm"
                                t-att-value="state.branchId"
                                t-on-change="onBranchChange">
                            <t t-foreach="state.branches" t-as="b" t-key="b.id">
                                <option t-att-value="b.id"
                                        t-att-selected="state.branchId === b.id ? 'selected' : ''">
                                    <t t-esc="b.name"/>
                                </option>
                            </t>
                        </select>
                        <input type="date"
                               class="form-control form-control-sm"
                               t-att-value="state.selectedDate"
                               t-on-change="onDateChange"/>
                        <button class="btn btn-sm btn-primary"
                                t-on-click="refresh"
                                t-att-disabled="state.loading ? 'disabled' : ''">
                            <i class="fa fa-refresh"/>
                            Refresh
                        </button>
                    </div>
                </div>

                <!-- Stats strip -->
                <div class="salon-cdb-stats">
                    <div class="salon-cdb-stat salon-cdb-stat-available">
                        <span class="salon-cdb-stat-num" t-esc="state.stats.available"/>
                        <span class="salon-cdb-stat-label">Available now</span>
                    </div>
                    <div class="salon-cdb-stat salon-cdb-stat-in_service">
                        <span class="salon-cdb-stat-num" t-esc="state.stats.in_service"/>
                        <span class="salon-cdb-stat-label">In service</span>
                    </div>
                    <div class="salon-cdb-stat salon-cdb-stat-booked">
                        <span class="salon-cdb-stat-num" t-esc="state.stats.booked"/>
                        <span class="salon-cdb-stat-label">Booked later</span>
                    </div>
                    <div class="salon-cdb-stat salon-cdb-stat-total">
                        <span class="salon-cdb-stat-num" t-esc="state.stats.total"/>
                        <span class="salon-cdb-stat-label">Chairs total</span>
                    </div>
                </div>

                <!-- Chair grid -->
                <t t-if="state.loading and !state.chairs.length">
                    <div class="salon-cdb-loading">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <p>Loading chairs…</p>
                    </div>
                </t>
                <t t-elif="!state.chairs.length">
                    <div class="salon-cdb-empty">
                        <i class="fa fa-th-large fa-3x"/>
                        <h3>No chairs yet</h3>
                        <p>
                            Add chairs to <strong t-esc="state.branchName or 'this branch'"/>
                            from the
                            <a href="/web#action=salon_management.action_salon_chair">
                                Chairs menu
                            </a>.
                        </p>
                    </div>
                </t>
                <t t-else="">
                    <div class="salon-cdb-grid">
                        <t t-foreach="state.chairs" t-as="chair" t-key="chair.id">
                            <div t-attf-class="salon-cdb-chair salon-cdb-chair-{{ chair.status }}"
                                 t-on-click="() => this.openChair(chair.id)">

                                <!-- Backrest: chair name + status badge -->
                                <div class="salon-cdb-backrest">
                                    <div class="salon-cdb-chair-name" t-esc="chair.name"/>
                                    <div t-if="chair.code" class="salon-cdb-chair-code" t-esc="chair.code"/>
                                    <div class="salon-cdb-chair-status">
                                        <span class="dot"/>
                                        <t t-esc="chair.status_label"/>
                                    </div>
                                </div>

                                <!-- Spine connector -->
                                <div class="salon-cdb-spine"/>

                                <!-- Seat: stylist + booking info -->
                                <div class="salon-cdb-seat">
                                    <t t-if="chair.stylist_name">
                                        <div class="salon-cdb-stylist">
                                            <div class="salon-cdb-avatar">
                                                <t t-if="chair.stylist_image">
                                                    <img t-att-src="image_src(chair.stylist_image)"
                                                         t-att-alt="chair.stylist_name"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="salon-cdb-initials"
                                                          t-esc="chair.stylist_name.slice(0,1)"/>
                                                </t>
                                            </div>
                                            <div class="salon-cdb-stylist-meta">
                                                <strong t-esc="chair.stylist_name"/>
                                                <small>Dedicated stylist</small>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="salon-cdb-no-stylist">No stylist assigned</div>
                                    </t>

                                    <t t-if="chair.current_appointment">
                                        <div class="salon-cdb-current">
                                            <strong t-esc="customer_name(chair.current_appointment)"/>
                                            <span class="meta">
                                                <t t-esc="format_time(chair.current_appointment.start_datetime)"/> –
                                                <t t-esc="format_time(chair.current_appointment.end_datetime)"/>
                                            </span>
                                        </div>
                                    </t>
                                    <t t-elif="chair.next_appointment">
                                        <div class="salon-cdb-next">
                                            <strong>Next: <t t-esc="customer_name(chair.next_appointment)"/></strong>
                                            <span class="meta">at <t t-esc="format_time(chair.next_appointment.start_datetime)"/></span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="salon-cdb-next">
                                            <strong>Available all day</strong>
                                            <span class="meta"><t t-esc="chair.appointment_count_today"/> bookings today</span>
                                        </div>
                                    </t>
                                </div>

                                <!-- Base + leg hint -->
                                <div class="salon-cdb-base"><span/></div>

                                <!-- Foot action -->
                                <button class="salon-cdb-action" t-on-click.stop="() => this.openChair(chair.id)">
                                    <i class="fa fa-calendar-o"/> View bookings
                                </button>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>