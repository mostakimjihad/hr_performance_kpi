<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_service_category_tree" model="ir.ui.view">
        <field name="name">salon.service.category.tree</field>
        <field name="model">salon.service.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="service_count"/>
                <field name="online_visible" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_salon_service_category_form" model="ir.ui.view">
        <field name="name">salon.service.category.form</field>
        <field name="model">salon.service.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="online_visible"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Services" name="services">
                            <field name="service_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salon_service_category" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">salon.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>