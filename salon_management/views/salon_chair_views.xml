<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_chair_tree" model="ir.ui.view">
        <field name="name">salon.chair.list</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <list string="Chairs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="stylist_id"/>
                <field name="color" widget="color_picker"/>
                <field name="appointment_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_salon_chair_form" model="ir.ui.view">
        <field name="name">salon.chair.form</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <form string="Chair">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_salon_appointment_list_by_chair)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo"
                                   string="Appointments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Chair name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="branch_id"/>
                            <field name="stylist_id"
                                   domain="[('branch_ids', 'in', branch_id)]"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_salon_chair_kanban" model="ir.ui.view">
        <field name="name">salon.chair.kanban</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" color="color">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="stylist_id"/>
                <field name="color"/>
                <field name="appointment_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_kanban_record oe_kanban_global_click salon-chair-kanban oe_kanban_color_#{record.color.raw_value or 0}">
                            <div class="o_kanban_details">
                                <strong><t t-esc="record.name.value"/></strong>
                                <div class="text-muted">
                                    <t t-esc="record.code.value"/>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-tag"/> <t t-esc="record.branch_id.value"/>
                                </div>
                                <div>
                                    <i class="fa fa-user"/> <t t-esc="record.stylist_id.value"/>
                                </div>
                                <div class="text-muted mt-1">
                                    <i class="fa fa-calendar"/> <t t-esc="record.appointment_count.value"/> appointments
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_chair_search" model="ir.ui.view">
        <field name="name">salon.chair.search</field>
        <field name="model">salon.chair</field>
        <field name="arch" type="xml">
            <search string="Chairs">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="stylist_id"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Branch" name="group_branch" domain="[]"
                            context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_salon_chair" model="ir.actions.act_window">
        <field name="name">Chairs</field>
        <field name="res_model">salon.chair</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_salon_chair_search"/>
    </record>

    <!-- ============================================================
         OWL Dashboard
         ============================================================ -->
    <record id="action_chair_dashboard" model="ir.actions.client">
        <field name="name">Chair Dashboard</field>
        <field name="tag">salon_management.chair_dashboard</field>
        <field name="target">current</field>
    </record>

</odoo>