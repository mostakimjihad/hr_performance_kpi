<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_appointment_calendar" model="ir.ui.view">
        <field name="name">salon.appointment.calendar</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="stylist_id"
                      mode="week"
                      quick_create="0"
                      event_open_popup="true">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="state"/>
                <field name="total_price" widget="monetary"/>
            </calendar>
        </field>
    </record>

    <record id="view_salon_appointment_tree" model="ir.ui.view">
        <field name="name">salon.appointment.tree</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments"
                  decoration-muted="state in ('cancelled', 'no_show')"
                  decoration-success="state in ('confirmed', 'in_progress', 'done')"
                  decoration-warning="state == 'draft'">
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="branch_id"/>
                <field name="stylist_id"/>
                <field name="chair_id" optional="show"/>
                <field name="service_summary" widget="char"/>
                <field name="partner_id"/>
                <field name="guest_name" string="Guest"
                       invisible="[('partner_id', '!=', False)]"/>
                <field name="duration" string="Total (h)" widget="float_time"/>
                <field name="total_price" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('confirmed', 'in_progress', 'done')"
                       decoration-danger="state == 'cancelled'"
                       decoration-muted="state == 'no_show'"/>
            </list>
        </field>
    </record>

    <record id="view_salon_appointment_form" model="ir.ui.view">
        <field name="name">salon.appointment.form</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="[('state', '!=', 'draft')]"/>
                    <button name="action_start" string="Start service"
                            type="object"
                            invisible="[('state', '!=', 'confirmed')]"/>
                    <button name="action_done" string="Mark done"
                            type="object" class="btn-success"
                            invisible="[('state', '!=', 'in_progress')]"/>
                    <button name="action_no_show" string="No-show"
                            type="object"
                            invisible="[('state', 'in', ('done', 'cancelled', 'no_show'))]"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="[('state', 'in', ('done', 'cancelled', 'no_show'))]"/>
                    <button name="action_reset_draft" string="Reset to draft"
                            type="object" groups="group_salon_manager"
                            invisible="[('state', '=', 'draft')]"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-globe"
                                name="action_open_portal_url"
                                type="object"
                                string="Portal link"
                                invisible="[('access_token', '=', False)]"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="stylist_id"
                                   domain="[('branch_ids', 'in', branch_id)]"/>
                            <field name="chair_id"
                                   domain="[('branch_id', '=', branch_id)]"/>
                            <field name="start_datetime"/>
                            <field name="duration" widget="float_time"/>
                            <field name="end_datetime" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="guest_name" invisible="[('partner_id', '!=', False)]"/>
                            <field name="guest_email" widget="email"
                                   invisible="[('partner_id', '!=', False)]"/>
                            <field name="guest_phone" widget="phone"
                                   invisible="[('partner_id', '!=', False)]"/>
                            <field name="total_price" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="service_id"
                                           domain="[('online_visible', '=', True)]"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customer Notes" name="notes">
                            <field name="guest_notes"/>
                        </page>
                        <page string="Other" name="other">
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="access_token"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_salon_appointment_kanban" model="ir.ui.view">
        <field name="name">salon.appointment.kanban</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="state"/>
                <field name="branch_id"/>
                <field name="stylist_id"/>
                <field name="partner_id"/>
                <field name="guest_name"/>
                <field name="total_price"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record oe_kanban_global_click">
                            <div class="o_kanban_details">
                                <strong><t t-esc="record.name.value"/></strong>
                                <div>
                                    <t t-esc="record.start_datetime.value"/>
                                </div>
                                <div class="text-muted">
                                    <t t-esc="record.branch_id.value"/>
                                    · <t t-esc="record.stylist_id.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_salon_appointment_pivot" model="ir.ui.view">
        <field name="name">salon.appointment.pivot</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Pivot" sample="1">
                <field name="branch_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_salon_appointment_graph" model="ir.ui.view">
        <field name="name">salon.appointment.graph</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <graph string="Graph" sample="1">
                <field name="branch_id"/>
                <field name="total_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_salon_appointment_search" model="ir.ui.view">
        <field name="name">salon.appointment.search</field>
        <field name="model">salon.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="guest_email"/>
                <field name="guest_name"/>
                <field name="stylist_id"/>
                <field name="branch_id"/>
                <separator/>
                <filter string="Draft" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="state_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="In progress" name="state_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="state_done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="state_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <filter string="No-show" name="state_no_show"
                        domain="[('state', '=', 'no_show')]"/>
                <filter string="Archived" name="archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Branch" name="group_branch" domain="[]"
                            context="{'group_by': 'branch_id'}"/>
                    <filter string="Stylist" name="group_stylist" domain="[]"
                            context="{'group_by': 'stylist_id'}"/>
                    <filter string="Status" name="group_state" domain="[]"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" domain="[]"
                            context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Actions
         ============================================================ -->
    <record id="action_salon_appointment_calendar" model="ir.actions.act_window">
        <field name="name">Appointment Calendar</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">calendar,list,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_salon_appointment_search"/>
    </record>

    <record id="action_salon_appointment_list" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,form,calendar,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_salon_appointment_search"/>
    </record>

    <record id="action_salon_appointment_pivot" model="ir.actions.act_window">
        <field name="name">Appointment Pivot</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <record id="action_salon_appointment_graph" model="ir.actions.act_window">
        <field name="name">Appointment Graph</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- Context-driven actions for stat buttons -->
    <record id="action_salon_appointment_list_by_branch" model="ir.actions.act_window">
        <field name="name">Appointments by Branch</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_group_state': 0}</field>
    </record>
    <record id="action_salon_appointment_list_by_stylist" model="ir.actions.act_window">
        <field name="name">Appointments by Stylist</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_salon_appointment_list_by_chair" model="ir.actions.act_window">
        <field name="name">Appointments by Chair</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_salon_appointment_portal_list" model="ir.actions.act_window">
        <field name="name">My Bookings</field>
        <field name="res_model">salon.appointment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>