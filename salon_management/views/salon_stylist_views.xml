<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_stylist_tree" model="ir.ui.view">
        <field name="name">salon.stylist.tree</field>
        <field name="model">salon.stylist</field>
        <field name="arch" type="xml">
            <list string="Stylists">
                <field name="employee_id"/>
                <field name="branch_ids" widget="many2many_tags"/>
                <field name="service_ids" widget="many2many_tags"/>
                <field name="appointment_count"/>
                <field name="online_visible" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_salon_stylist_form" model="ir.ui.view">
        <field name="name">salon.stylist.form</field>
        <field name="model">salon.stylist</field>
        <field name="arch" type="xml">
            <form string="Stylist">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_salon_appointment_list_by_stylist)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo"
                                   string="Appointments"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1><field name="employee_id" placeholder="Employee"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="online_visible"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Branches" name="branches">
                            <field name="branch_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Services" name="services">
                            <field name="service_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Chairs" name="chairs">
                            <field name="chair_ids"/>
                        </page>
                        <page string="Bio" name="bio">
                            <field name="bio"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_salon_stylist_kanban" model="ir.ui.view">
        <field name="name">salon.stylist.kanban</field>
        <field name="model">salon.stylist</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="employee_id"/>
                <field name="branch_ids"/>
                <field name="appointment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record oe_kanban_global_click">
                            <field name="image" widget="image" class="o_kanban_image_fill w-100"
                                   alt="Stylist photo"/>
                            <div class="o_kanban_details">
                                <strong><t t-esc="record.employee_id.value"/></strong>
                                <div class="text-muted">
                                    <t t-esc="record.appointment_count.value"/> appointments
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_salon_stylist" model="ir.actions.act_window">
        <field name="name">Stylists</field>
        <field name="res_model">salon.stylist</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>